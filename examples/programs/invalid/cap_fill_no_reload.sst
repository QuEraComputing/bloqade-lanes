.text(root):
// Fill instruction — requires atom_reloading capability.
// Should fail when arch spec has atom_reloading = false (default).
// LocationAddr (64-bit): [zone_id:8][word_id:16][site_id:16][pad:24]

fn @main() {
  lanes.const_loc 0x0000000000000000    // zone 0, word 0, site 0
  lanes.const_loc 0x0000000001000000    // zone 0, word 0, site 1
  lanes.initial_fill 2

  // Fill (not initial_fill) requires atom_reloading
  lanes.const_loc 0x0000000002000000    // zone 0, word 0, site 2
  lanes.const_loc 0x0000000003000000    // zone 0, word 0, site 3
  lanes.fill 2

  cpu.halt
}
.text(root).
.section(root).
