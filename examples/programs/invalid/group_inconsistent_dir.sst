// arch: simple
// expect: LaneGroupValidation
// Invalid: move group has lanes with different direction
// Lane 0: forward, Lane 1: backward
// dir=1 (backward) sets bit 63 -> 0x8000000000000000

fn @main() {
  lanes::lanes.const_lane 0x0000000000000000    // fwd, site_bus, word 0, site 0, bus 0
  lanes::lanes.const_lane 0x8000000000000001    // bwd, site_bus, word 0, site 1, bus 0
  lanes::lanes.move 2
  cpu::cpu.halt
}
