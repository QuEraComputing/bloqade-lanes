// arch: simple
// expect: InvalidLocation
// Invalid: site_id=15 out of range (only 10 sites per word)
// LocationAddr (64-bit): [zone_id:8][word_id:16][site_id:16][pad:24]
// zone 0, word 0, site 15 = (15 << 24) = 0x000000000f000000

fn @main() {
  lanes::lanes.const_loc 0x000000000f000000    // zone 0, word 0, site 15
  cpu::cpu.halt
}
