// Valid forward site_bus lanes on bus 0, word 0
// LaneAddr (64-bit): [dir:1][mt:2][zone_id:8][pad:5][bus:16][word:16][site:16]
// site_bus 0: src=[0,1,2,3,4] dst=[5,6,7,8,9]

fn @main() {
  lanes::lanes.const_lane 0x0000000000000000    // fwd, site_bus, word 0, site 0, bus 0
  lanes::lanes.const_lane 0x0000000000000001    // fwd, site_bus, word 0, site 1, bus 0
  lanes::lanes.const_lane 0x0000000000000002    // fwd, site_bus, word 0, site 2, bus 0
  cpu::cpu.halt
}
.text(root).
