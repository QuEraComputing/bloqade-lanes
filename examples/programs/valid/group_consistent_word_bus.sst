version 1.0
.header(root).
.text(root):
// arch: full
// Move 2 lanes on the same word_bus, same direction.
// LaneAddr (64-bit): [dir:1][mt:2][zone_id:8][pad:5][bus:16][word:16][site:16]
// mt=1 (word_bus) sets bits 62-61 -> 0x2000000000000000
// word_bus 0: src=[0] dst=[1]
// sites_with_word_buses: [5,6,7,8,9]

fn @main() {
  lanes::lanes.const_lane 0x2000000000000005    // fwd, word_bus, zone 0, word 0, site 5, bus 0
  lanes::lanes.const_lane 0x2000000000000006    // fwd, word_bus, zone 0, word 0, site 6, bus 0
  lanes::lanes.move 2
  cpu::cpu.halt
}
.text(root).
.section(root).
